; RUN CONTROL PARAMETERS
integrator   = md
dt           = 0.002 ; 2 fs
nsteps       = 500000 ; 1 ns
;
nstxout-compressed      = 500
nstlog                  = 500
nstenergy               = 500
;
nstlist      = 10
ns_type      = grid
pbc          = xyz
rlist        = 1.4
;
coulombtype  = PME
rcoulomb     = 1.2
;
vdwtype      = cut-off
rvdw         = 1.2
dispcorr     = enerpres
;
optimize_fft = yes
;
tcoupl       = v-rescale
tau_t        = 2.0
ref_t        = 300.0
tc_grps      = SOL
;
;
pcoupl       = C-rescale
pcoupltype   = isotropic
tau_p        = 1.0
compressibility = 4.5e-5
ref_p        = 1.0
;
refcoord_scaling = all
gen_vel      = no
gen_seed     = -1
;
continuation= yes; Restarting after previous RUN
constraints  = hbonds
constraint_algorithm = LINCS
